# 実行時の設定の見本。すべて既定値で動くため、変える場合だけ .env にコピーして編集する。
# 一覧と意味は docs/architecture.md「環境変数」。scripts/dev.sh は .env があればサーバーに渡す。

# 待ち受けるポート(Uvicorn の --port に渡す)。scripts/dev.sh はこの値を使わず、8000 で固定する
# (画面の開発サーバーの中継先 web/vite.config.ts と合わせるため)
PORT=8000

# 変換用辞書のパス(相対パスはリポジトリ直下が基準)
S7_DICTIONARY_PATH=data/build/s7dict.sqlite

# 画面のビルド結果のディレクトリ(相対パスはリポジトリ直下が基準)
S7_STATIC_DIR=web/dist

# ログの形式: json か text(手元で読みやすくする)
S7_LOG_FORMAT=json

# ログの出力レベル: DEBUG、INFO、WARNING、ERROR
S7_LOG_LEVEL=INFO

# 信頼する前段のプロキシの段数(手元では0)
S7_TRUSTED_PROXY_HOPS=0
